{
  "name": "ai-voice-chat",
  "version": "1.0.0",
  "private": true,
  "description": "本地运行的 AI 实时语音对话：VAD 免点击 + 流式 LLM + 流式 TTS + 可打断，附带 Claude Code voice-chat skill",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File scripts/start.ps1",
    "stop": "powershell -ExecutionPolicy Bypass -File scripts/stop.ps1",
    "restart": "powershell -ExecutionPolicy Bypass -File scripts/restart.ps1",
    "dev": "node --watch server/server.js",
    "postinstall": "node scripts/setup-vendor.mjs"
  },
  "dependencies": {
    "@ricky0123/vad-web": "^0.0.30",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "multer": "^2.0.1",
    "onnxruntime-web": "^1.29.0",
    "sherpa-onnx-node": "^1.13.6"
  }
}
