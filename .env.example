# ============================================
# AI 语音对话 - 环境变量配置
# 复制本文件为 .env 并修改：
#   copy .env.example .env
# ============================================

# ---------- LLM 配置（OpenAI 兼容接口，任选其一） ----------

# 默认示例：智谱 GLM（国内直连快）
#   Key 获取：https://open.bigmodel.cn → 控制台 → API Key
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-5.2

# 方案 2：硅基流动（一个 Key 可同时用作 LLM/ASR/TTS 云端备用）
# LLM_API_KEY=sk-你的硅基流动key
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=deepseek-ai/DeepSeek-V3

# 方案 3：本地 Ollama（完全免 key）
#   先安装 Ollama (https://ollama.com)，再拉模型，例如：
#     ollama pull qwen2.5:7b
#   LLM_API_KEY 留空即可，程序会自动尝试 http://localhost:11434
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b

# 方案 4：DeepSeek 官方 / OpenAI 等其他 OpenAI 兼容服务同理，改 BASE_URL 和 MODEL
# ⚠️ 语音对话必须用【非 thinking】对话模型！
#   推理模型（deepseek-reasoner、R1 系列、Qwen3 等）回答前先跑思维链，非常慢。

# 限制单次回答的最大 token 数（防止回答过长、加快响应）
LLM_MAX_TOKENS=1000

# ---------- 语音识别（ASR）配置（云端备用） ----------
# 语音默认走本地 sherpa-onnx（完全离线，见下方"本地语音引擎"），模型缺失/失败才回退云端。
# 云端识别用硅基流动：默认复用 LLM_API_KEY / LLM_BASE_URL，
# ⚠️ 但 LLM 用智谱等非硅基流动服务时，必须单独指定 ASR 的 Key 和地址！
# 识别模型：XingChenAGI/XingChenASR-V3.2（硅基流动，速度快、中文识别好）
ASR_MODEL=XingChenAGI/XingChenASR-V3.2
# 默认取 LLM_API_KEY（硅基流动 Key），LLM 非硅基流动时取消注释填硅基流动 Key：
# ASR_API_KEY=
# 默认取 LLM_BASE_URL，LLM 非硅基流动时取消注释：
# ASR_BASE_URL=https://api.siliconflow.cn/v1

# ---------- 语音合成（TTS）配置（云端备用） ----------
# 语音默认走本地 sherpa-onnx（见下），模型缺失/失败才回退云端。
# 云端合成用硅基流动 CosyVoice2（专业 TTS，短句也正常；MOSS-TTSD 是对话模型，短句会乱说，不推荐）
# 可选音色（完整格式）：FunAudioLLM/CosyVoice2-0.5B:{alex|bella|anna|david}
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:bella
# 默认语速（0.25~4.0，1.0 正常；页面上的语速选择器可随时覆盖）
TTS_SPEED=1.0
# ⚠️ LLM 用智谱等非硅基流动服务时，必须单独指定 TTS 的 Key 和地址（CosyVoice2 是硅基流动的模型）：
# TTS_API_KEY=
TTS_BASE_URL=https://api.siliconflow.cn/v1

# ---------- 本地语音引擎（sherpa-onnx，完全离线，免 Key 免额度） ----------
# ASR=SenseVoice(int8) 本地识别；TTS=matcha-zh-baker 本地合成
# 提供方：auto（本地就绪用本地，失败/未就绪自动回退云端）/ local / cloud
ASR_PROVIDER=local
TTS_PROVIDER=local
# TTS 模型类型：matcha（默认，快+自然，baker 数据集仅限非商用）| vits（melo 音色）
SHERPA_TTS_MODEL_TYPE=matcha
# 模型目录（相对项目根，也可用绝对路径）
SHERPA_ASR_MODEL_DIR=models/asr/sense-voice
SHERPA_TTS_MODEL_DIR=models/tts/matcha-zh-baker/matcha-icefall-zh-baker
SHERPA_TTS_MODEL_FILE=model-steps-3.onnx
SHERPA_TTS_VOCODER=models/tts/matcha-zh-baker/vocos-22khz-univ.onnx
# matcha 模型天生偏响约 10dB，0.4 可压到 melo 音量水平（觉得小声就调回 1.0）
SHERPA_TTS_GAIN=0.4
# 切回 vits-melo 音色的方法：TYPE=vits、DIR=models/tts/vits-melo-tts-zh_en、
#   FILE=model.onnx、注释掉 VOCODER 和 GAIN 两行
# 线程数（4 线程实测：TTS 首块音频 ~0.2s / RTF 0.34；ASR 8s 音频识别 ~0.26s）
SHERPA_ASR_NUM_THREADS=4
SHERPA_TTS_NUM_THREADS=4
# TTS 按句出音频（1=首块延迟最低，推荐；-1=整段一次出）
SHERPA_TTS_MAX_SENTENCES=1
# 说话人 id（melo zh_en 单说话人固定 0）
SHERPA_TTS_SID=0
# ASR 语言（留空自动检测；可 zh/en/ja/ko/yue）
SHERPA_ASR_LANGUAGE=

# ---------- 对话人设 ----------
# 注：只写适合朗读的连贯口语，禁止表情符号/Markdown/特殊符号，避免 TTS 合成出奇怪声音。
#     prompt 里不要出现 # 号（dotenv 会当作注释截断后面的内容）。
SYSTEM_PROMPT=你是一位声音温柔、真诚热情的语音朋友，和用户像熟人聊天一样自然地说话。语气亲切放松，可以适度用呀、啦、哦这样的语气词，让对方觉得舒服、被关心。每次回答控制在两三句、80字以内，一次只聊一个重点，最重要的先说。对方分享开心的事就由衷地为对方高兴，对方情绪低落时先安慰共情再一起想办法，对方只是闲聊就轻松地接住话茬。没听清或信息不够时，用一个简短的问题友好地确认。不确定或不知道的事就坦诚说不知道，绝不编造。只输出适合朗读的连贯中文口语，不要任何表情符号、序号、列表、括号和 Markdown 符号，不要机械重复对方的问题，也不要每次都用还有什么可以帮你的这类话结尾。

# ---------- 服务端口 ----------
PORT=3000
