# ============================================
# AI 语音对话 - 环境变量配置
# 复制本文件为 .env 并修改：
#   copy .env.example .env
# ============================================

# ---------- LLM 配置（OpenAI 兼容接口，三选一） ----------

# 方案 1：本地 Ollama（完全免 key，推荐）
#   先安装 Ollama (https://ollama.com)，再拉模型，例如：
#     ollama pull qwen2.5:7b
#   API_KEY 留空即可，程序会自动尝试 http://localhost:11434
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b

# 方案 2：DeepSeek（便宜，国内直连快）
#   ⚠️ 语音对话请用 deepseek-chat（非 thinking 模型）！
#      不要用 deepseek-reasoner / 各种 R1 推理模型，它们回答前先跑思维链，非常慢。
# LLM_API_KEY=sk-你的deepseek-key
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# 方案 3：OpenAI
# LLM_API_KEY=sk-你的openai-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 其他任意 OpenAI 兼容服务（硅基流动、通义千问、Moonshot 等）同理，填各自的 BASE_URL 和 MODEL 即可。
#   例：硅基流动 + 非 thinking 模型（推荐，无思维链、响应快）
#   LLM_BASE_URL=https://api.siliconflow.cn/v1
#   LLM_MODEL=deepseek-ai/DeepSeek-V3
#   ⚠️ 注意：硅基流动的 Qwen/Qwen3-8B 默认开启思维链（会输出 reasoning_content），语音场景慎用。

# 限制单次回答的最大 token 数（防止回答过长、加快响应）
LLM_MAX_TOKENS=200

# ---------- 语音识别（ASR）配置 ----------
# 默认复用上面的 LLM_API_KEY 和 LLM_BASE_URL（硅基流动 Key 通用），一般不用改。
# 配置后前端将使用「录音上传识别」引擎（国内稳定），不再依赖 Chrome 的 Google 识别服务。
# 识别模型：XingChenAGI/XingChenASR-V3.2-Ultra（硅基流动，速度快、中文识别好）
# 可选：FunAudioLLM/SenseVoiceSmall
ASR_MODEL=XingChenAGI/XingChenASR-V3.2-Ultra
# ASR_API_KEY=    # 需要单独指定时取消注释（默认取 LLM_API_KEY）
# ASR_BASE_URL=   # 需要单独指定时取消注释（默认取 LLM_BASE_URL）

# ---------- 语音合成（TTS）配置 ----------
# CosyVoice2：专业 TTS，短句也正常（MOSS-TTSD 是对话模型，短句会乱说，不推荐）
# 可选音色（完整格式）：FunAudioLLM/CosyVoice2-0.5B:{alex|bella|anna|david}
TTS_MODEL=FunAudioLLM/CosyVoice2-0.5B
TTS_VOICE=FunAudioLLM/CosyVoice2-0.5B:bella
# 默认语速（0.25~4.0，1.0 正常；页面上的语速选择器可随时覆盖）
TTS_SPEED=1.0
# TTS_API_KEY=    # 需要单独指定时取消注释（默认取 LLM_API_KEY）

# ---------- 本地语音引擎（sherpa-onnx，完全离线） ----------
# ASR=SenseVoice(int8) 本地识别；TTS=matcha-zh-baker 本地合成，不再走云端 API
# 提供方：auto（默认，本地就绪用本地，失败/未就绪自动回退云端）/ local / cloud
ASR_PROVIDER=auto
TTS_PROVIDER=auto
# TTS 模型类型：matcha（推荐，快+自然，baker 数据集仅限非商用）| vits（melo）
SHERPA_TTS_MODEL_TYPE=matcha
# 模型目录（相对项目根，也可用绝对路径）
SHERPA_ASR_MODEL_DIR=models/asr/sense-voice
SHERPA_TTS_MODEL_DIR=models/tts/matcha-zh-baker/matcha-icefall-zh-baker
SHERPA_TTS_MODEL_FILE=model-steps-3.onnx
SHERPA_TTS_VOCODER=models/tts/matcha-zh-baker/vocos-22khz-univ.onnx
# 线程数（4 线程实测：TTS 首块音频 ~0.2s / RTF 0.34；ASR 8s 音频识别 ~0.26s）
SHERPA_ASR_NUM_THREADS=4
SHERPA_TTS_NUM_THREADS=4
# TTS 按句出音频（1=首块延迟最低，推荐；-1=整段一次出）
SHERPA_TTS_MAX_SENTENCES=1
# 说话人 id（melo zh_en 单说话人固定 0）
SHERPA_TTS_SID=0
# ASR 语言（留空自动检测；可 zh/en/ja/ko/yue）
SHERPA_ASR_LANGUAGE=

# ---------- 对话人设 ----------
# 注：只写适合朗读的连贯口语，禁止表情符号/Markdown/特殊符号，避免 TTS 合成出奇怪声音。
#     prompt 里不要出现 # 号（dotenv 会当作注释截断后面的内容）。
SYSTEM_PROMPT=你是小暖，一位声音温柔、真诚热情的语音朋友，和用户像熟人聊天一样自然地说话。语气亲切放松，可以适度用呀、啦、哦这样的语气词，让对方觉得舒服、被关心。每次回答控制在两三句、80字以内，一次只聊一个重点，最重要的先说。对方分享开心的事就由衷地为对方高兴，对方情绪低落时先安慰共情再一起想办法，对方只是闲聊就轻松地接住话茬。没听清或信息不够时，用一个简短的问题友好地确认。不确定或不知道的事就坦诚说不知道，绝不编造。只输出适合朗读的连贯中文口语，不要任何表情符号、序号、列表、括号和 Markdown 符号，不要机械重复对方的问题，也不要每次都用还有什么可以帮你的这类话结尾。

# ---------- 服务端口 ----------
PORT=3000

# ---------- 智能打断阈值(pipecat 版新增,毫秒) ----------
# 确认真实语音的时长(≥ 才算一句话,防误触发)
INTERRUPT_CONFIRM_MS=300
# 持续说话达到此时长才升级为"打断";不足视为短插话(AI 从暂停点继续)
INTERRUPT_SUSTAIN_MS=500
# 短插话缓冲等待后续话语的合并窗口
INTERRUPT_MERGE_TIMEOUT_MS=3000

# ---------- 架构说明 ----------
# v2 起:语音管线迁移到官方 pipecat(Python/uv 管理,.venv 目录),
#   服务 = FastAPI + WebSocket 管线(识别/思考/合成为可插拔 service);
#   前端 = TypeScript(esbuild 构建,产物在 frontend/dist/,由本服务托管);
#   VAD 仍留在浏览器(回声消除作用于采集层)。
# 兼容接口 /api/asr /api/tts /api/config /api/history 行为与旧版一致。
